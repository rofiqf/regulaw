# Provider LLM: lmstudio (default, server lokal) atau groq
LLM_PROVIDER=lmstudio

# LM Studio (OpenAI-compatible). API key boleh apa saja, LM Studio tidak memvalidasinya.
LM_STUDIO_BASE_URL=http://192.168.200.6:1234/v1
LM_STUDIO_API_KEY=lm-studio
LM_STUDIO_MODEL=qwen2.5-3b-instruct

# Groq (hanya dipakai jika LLM_PROVIDER=groq)
GROQ_API_KEY=
GROQ_MODEL=llama-3.3-70b-versatile

# Gemini (hanya dipakai jika LLM_PROVIDER=gemini)
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.8-flash
